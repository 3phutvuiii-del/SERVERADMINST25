datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  SENIOR_ADMIN
  MODERATOR
  TRIAL_MOD
}

model AdminUser {
  id            String    @id @default(uuid())
  discordId     String    @unique
  username      String
  avatar        String?
  role          Role      @default(MODERATOR)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  auditLogs     AuditLog[]
}

model AuditLog {
  id             String     @id @default(uuid())
  actorId        String
  actorName      String
  actorRole      Role
  action         String
  targetSteamId  String?
  targetName     String?
  reason         String?
  payload        Json?
  status         String     @default("SUCCESS")
  createdAt      DateTime   @default(now())

  adminUser      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model PlayerNote {
  id             String    @id @default(uuid())
  steamId        String
  playerName     String?
  authorName     String
  note           String
  strikeLevel    Int       @default(0) // 0: Note, 1: Warning, 2: Final Warning, 3: Strike
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PrimeMember {
  id             String    @id @default(uuid())
  steamId        String    @unique
  playerName     String
  discordId      String?
  tier           String    @default("PRIME_ELDER")
  growthMultiplier Float   @default(1.5)
  garageSlots    Int       @default(4)
  priorityQueue  Boolean   @default(true)
  startsAt       DateTime  @default(now())
  expiresAt      DateTime
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

model CombatViolation {
  id             String    @id @default(uuid())
  killId         String    @unique
  killerSteamId  String?
  killerName     String?
  victimSteamId  String
  victimName     String
  violationType  String    // REVENGE_KILL_5M, APEX_PACK_RULE, SUSPICIOUS_BURST
  severity       String    // LOW, MEDIUM, CRITICAL
  details        String
  reviewed       Boolean   @default(false)
  reviewedBy     String?
  createdAt      DateTime  @default(now())
}

model DiscordRolePermission {
  id          String   @id @default(uuid())
  roleName    String   @unique
  description String?
  badgeColor  String?  @default("#3b82f6")
  permissions Json     // Object of boolean permission flags
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model AnnouncementTemplate {
  id             String   @id @default(uuid())
  title          String
  content        String
  category       String   @default("general") // general, rules, event, maintenance, discord
  enabledForAuto Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AutoAnnounceConfig {
  id                   Int       @id @default(1)
  enabled              Boolean   @default(false)
  intervalMinutes      Int       @default(15)
  mode                 String    @default("sequential") // sequential | random
  currentTemplateIndex Int       @default(0)
  lastBroadcastAt      DateTime?
  nextBroadcastAt      DateTime?
}

model BroadcastHistory {
  id         String   @id @default(uuid())
  content    String
  source     String   @default("manual") // manual | auto
  senderName String
  status     String   @default("SUCCESS") // SUCCESS | FAILED
  sentAt     DateTime @default(now())
}

model MutationAuditLog {
  id               String   @id @default(uuid())
  actorName        String
  actorRole        String
  targetSteamId    String
  targetPlayerName String?
  species          String?
  mutations        Json     // Array of mutation strings
  elder            String?  // No elder, Frail, Prime
  reason           String
  status           String   @default("SUCCESS")
  createdAt        DateTime @default(now())
}

model SavedDino {
  dinoId             String   @id
  steamId            String?
  playerName         String?
  species            String?
  gender             String?
  growth             Float?
  mutations          Json     // Array of mutation names
  reincarnationCount Int      @default(0)
  elder              String?
  isPrimeElder       Boolean  @default(false)
  lineage            Json?    // { parent, elderA, elderB }
  updatedAt          DateTime @updatedAt
}
